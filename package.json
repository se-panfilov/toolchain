{
  "name": "toolchain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run format:check && npm run lint && npm test",
    "clean:reinstall": "npm ci --ignore-scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gitleaks:staged": "node scripts/scan-secrets.mjs staged",
    "gitleaks:history": "node scripts/scan-secrets.mjs history",
    "gitleaks:files": "node scripts/scan-secrets.mjs files",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "lefthook validate",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:fix:all": "npm run --workspaces --if-present lint:fix",
    "prettier:changed": "node scripts/format-changed.mjs",
    "pretty-quick": "node scripts/format-changed.mjs --staged",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:hooks": "vitest run --config configs/hooks.vitest.config.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:check:all": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
