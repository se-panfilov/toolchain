{
  "name": "tx-rehistory",
  "version": "2.3.3",
  "description": "Интерактивная нормализация, аудит и проверяемый экспорт истории Git",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "tx-rehistory": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/engine.js",
    "dist/audit.js",
    "dist/export.js",
    "dist/demo.js",
    "dist/prompts.js",
    "README.md",
    "SECURITY.md",
    "TERMINOLOGY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run build && node --test build.test.mjs dist/engine.test.js dist/features.test.js dist/prompts.test.js",
    "start": "npm run build && node dist/cli.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
