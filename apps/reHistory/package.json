{
  "name": "tx-rehistory",
  "version": "3.0.2",
  "description": "Interactive rewrite of Git commit dates, authors or messages, with audit and verifiable export",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "tx-rehistory": "dist/src/cli.js"
  },
  "files": [
    "dist/src/cli.js",
    "dist/src/engine.js",
    "dist/src/audit.js",
    "dist/src/export.js",
    "dist/src/demo.js",
    "dist/src/prompts.js",
    "dist/src/remote.js",
    "README.md",
    "SECURITY.md",
    "TERMINOLOGY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run build && vitest run",
    "start": "npm run build && node dist/src/cli.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:watch": "vitest test/unit.test.ts test/prompts.test.ts",
    "test:unit": "vitest run test/unit.test.ts test/prompts.test.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "check": "npm run format:check && npm run lint && npm test",
    "release": "npm pack --ignore-scripts && node scripts/publish.mjs",
    "release:dry-run": "npm run release -- --dry-run"
  },
  "exports": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/se-panfilov/toolchain.git",
    "directory": "apps/reHistory"
  },
  "keywords": [
    "git",
    "cli",
    "history",
    "rewrite git history",
    "timestamps"
  ]
}
