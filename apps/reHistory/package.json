{
  "name": "tx-rehistory",
  "version": "2.5.2",
  "description": "Interactive normalization, audit and verifiable export of Git history",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "tx-rehistory": "dist/src/cli.js"
  },
  "files": [
    "dist/src/cli.js",
    "dist/src/engine.js",
    "dist/src/audit.js",
    "dist/src/export.js",
    "dist/src/demo.js",
    "dist/src/prompts.js",
    "dist/src/remote.js",
    "README.md",
    "SECURITY.md",
    "TERMINOLOGY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run build && vitest run",
    "start": "npm run build && node dist/src/cli.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:watch": "vitest test/unit.test.ts test/prompts.test.ts",
    "test:unit": "vitest run test/unit.test.ts test/prompts.test.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test",
    "release": "npm run check && npm pack --ignore-scripts && npm publish --ignore-scripts --registry=https://registry.npmjs.org/ --access=public",
    "release:dry-run": "npm run release -- --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "exports": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/se-panfilov/toolchain.git",
    "directory": "apps/reHistory"
  },
  "keywords": [
    "git",
    "cli",
    "history",
    "timestamps"
  ]
}
