{
  "name": "rehistory",
  "version": "2.3.3",
  "description": "Интерактивная нормализация, аудит и проверяемый экспорт истории Git",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "rehistory": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/engine.js",
    "dist/audit.js",
    "dist/export.js",
    "dist/demo.js",
    "dist/prompts.js",
    "README.md",
    "SECURITY.md",
    "TERMINOLOGY.md",
    "NPX_RELEASE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test engine.test.ts features.test.ts prompts.test.ts",
    "start": "node cli.ts",
    "build": "node build.mjs",
    "prepack": "npm run build"
  }
}
